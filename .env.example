# SAARTHI PAYTM: Environment Configuration Template
# Copy this file to .env.local and populate with your credentials.
# .env.local is ignored by Git to prevent credential leaks.

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Sarvam AI (Speech-to-Text and Text-to-Speech)
SARVAM_API_KEY=your_sarvam_api_key_here

# Cognee Knowledge Graph & Memory Layer
COGNEE_BASE_URL=https://your-cognee-instance.ai
COGNEE_API_KEY=your_cognee_api_key_here

# Optional: Automation & Webhook Integration
N8N_WEBHOOK_URL=https://your-n8n-instance/webhook/saarthi
MERCHANT_ID=PTM88291048
